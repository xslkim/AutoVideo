{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autovideo/schemas/block.schema.json",
  "title": "AutoVideo v2 blocks.json",
  "description": "Block-based video structure produced by Stage 1 compiler",
  "type": "object",
  "required": ["version", "meta", "blocks"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "meta": {
      "type": "object",
      "required": ["title", "aspect", "resolution", "fps", "theme", "voice"],
      "properties": {
        "title":      { "type": "string" },
        "aspect":     { "type": "string", "enum": ["16:9","9:16","1:1"] },
        "resolution": {
          "type": "object",
          "required": ["w","h"],
          "properties": { "w": {"type":"integer"}, "h": {"type":"integer"} }
        },
        "fps":    { "type": "integer", "default": 30 },
        "theme":  { "type": "string", "default": "dark-code" },
        "voice":  { "type": "string" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Block" }
    }
  },
  "$defs": {
    "Rect": {
      "type": "object",
      "required": ["x","y","w","h"],
      "properties": {
        "x": {"type":"number","minimum":0,"maximum":1},
        "y": {"type":"number","minimum":0,"maximum":1},
        "w": {"type":"number","minimum":0,"maximum":1},
        "h": {"type":"number","minimum":0,"maximum":1}
      }
    },
    "Animation": {
      "type": "object",
      "required": ["preset","duration"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "none","fade","fade-up","fade-down","fade-left","fade-right",
            "scale","zoom-in","zoom-out","typewriter","draw","blur-in","blur-out","auto"
          ]
        },
        "duration": { "type": "number", "minimum": 0, "maximum": 3 },
        "easing": { "type": "string", "default": "ease-out" }
      }
    },
    "ContentSpec": {
      "type": "object",
      "required": ["type","spec"],
      "properties": {
        "type": { "type": "string", "enum": ["image","code","animation","icon","lottie","video","textcard"] },
        "spec": { "type": "object" }
      }
    },
    "SubtitleEntry": {
      "type": "object",
      "required": ["text","startMs","endMs"],
      "properties": {
        "text":     { "type": "string" },
        "startMs":  { "type": "number", "minimum": 0 },
        "endMs":    { "type": "number", "minimum": 0 },
        "emphases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start","end"],
            "properties": {
              "start": {"type":"integer"},
              "end":   {"type":"integer"}
            }
          }
        }
      }
    },
    "Block": {
      "type": "object",
      "required": ["id","title","narration","visual"],
      "properties": {
        "id":    { "type": "string", "pattern": "^B[0-9]+$" },
        "title": { "type": "string" },
        "narration": {
          "type": "object",
          "required": ["text","emphases","hints"],
          "properties": {
            "text": { "type": "string" },
            "emphases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["start","end","word"],
                "properties": {
                  "start": {"type":"integer"},
                  "end":   {"type":"integer"},
                  "word":  {"type":"string"}
                }
              }
            },
            "hints": {
              "type": "object",
              "properties": {
                "pauseAfter": { "type": "number", "minimum": 0 },
                "rate":       { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0 },
                "style":      { "type": "string", "default": "neutral" }
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "required": ["rect","enter","content","exit"],
          "properties": {
            "rect":    { "$ref": "#/$defs/Rect" },
            "enter":   { "$ref": "#/$defs/Animation" },
            "content": { "$ref": "#/$defs/ContentSpec" },
            "exit":    { "$ref": "#/$defs/Animation" }
          }
        },
        "timing": {
          "type": "object",
          "description": "Filled in by Stage 2 after TTS",
          "properties": {
            "audioPath":      { "type": "string" },
            "vttPath":        { "type": "string" },
            "ttsDuration":    { "type": "number" },
            "enterDuration":  { "type": "number" },
            "holdDuration":   { "type": "number" },
            "exitDuration":   { "type": "number" },
            "totalDuration":  { "type": "number" },
            "startFrame":     { "type": "integer" },
            "frames":         { "type": "integer" },
            "provider":       { "type": "string" }
          }
        },
        "subtitles": {
          "type": "array",
          "items": { "$ref": "#/$defs/SubtitleEntry" }
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "componentPath": { "type": "string" },
            "assetFiles":    { "type": "array", "items": { "type":"string" } },
            "thumbnailPath": { "type": "string" }
          }
        },
        "status": {
          "type": "object",
          "properties": {
            "tts":       { "type": "string", "enum": ["pending","running","completed","error","skipped"] },
            "component": { "type": "string", "enum": ["pending","running","completed","error","skipped"] },
            "render":    { "type": "string", "enum": ["pending","running","completed","error","skipped"] }
          }
        }
      }
    }
  }
}
