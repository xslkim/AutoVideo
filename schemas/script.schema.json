{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo Script",
  "description": "Schema for script.json — the canonical IR that flows through all AutoVideo stages. Fields are lenient; stage-specific readiness is enforced at the TypeScript layer.",
  "type": "object",
  "required": ["meta", "blocks", "assets", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "title", "voiceRef", "aspect", "width", "height", "fps", "theme", "subtitleSafeBottom"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "voiceRef": {
          "type": "string",
          "description": "Absolute path to reference audio WAV file"
        },
        "aspect": {
          "type": "string",
          "enum": ["16:9", "9:16", "1:1"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "subtitleSafeBottom": {
          "type": "number",
          "minimum": 0
        },
        "avatarRef": {
          "type": "string",
          "description": "Absolute path to avatar loop video for lip-sync overlay"
        },
        "skipLipsync": {
          "type": "boolean",
          "description": "Skip MuseTalk lip-sync, just overlay avatar.mp4 on repeat (default false)"
        },
        "avatarRadius": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128,
          "description": "PiP corner radius in pixels for avatar overlay (default 24)"
        },
        "subtitleStyle": {
          "type": "string",
          "enum": ["teach", "karaoke", "hype"],
          "description": "字幕风格：teach 整行淡入+关键词变色（默认）；karaoke 逐字扫光；hype 弹跳大字粗描边"
        },
        "avatarBackend": {
          "type": "string",
          "enum": ["musetalk", "echomimic"],
          "description": "数字人后端。缺省时按 avatarRef 扩展名推断:图片(png/jpg/jpeg/webp)→ echomimic,视频(mp4)→ musetalk。echomimic 输出固定 768×768 半身片段。"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "enter", "exit", "visual", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B\\d{2,}$",
            "description": "Block ID, e.g. B01, B02"
          },
          "title": {
            "type": "string"
          },
          "visualMode": {
            "type": "string",
            "enum": ["animation", "image", "video", "html", "aivideo"],
            "default": "animation",
            "description": "Visual generation mode: animation (Claude-generated Component.tsx), image (AI-generated PNG), video (local mp4 file), html (user-authored HTML/CSS/JS rendered via headless Chrome), or aivideo (AI text-to-video clip, generated at the visuals stage and converted to video mode)"
          },
          "imageSource": {
            "type": "string",
            "description": "Path to the source image file (e.g., 'assets/abc12345.png'), set during compile for image mode blocks"
          },
          "videoSource": {
            "type": "string",
            "description": "Path to the source video file (e.g., 'assets/abc12345.mp4'), set during compile for video mode blocks"
          },
          "htmlSource": {
            "type": "string",
            "description": "Path to the source HTML file (e.g., 'assets/abc12345.html'), set during compile for html mode blocks with html(./path) syntax"
          },
          "enter": {
            "type": "string",
            "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "zoom-in", "zoom-out", "blur-in", "mask-reveal", "zoom-settle", "slide-mask", "none"]
          },
          "exit": {
            "type": "string",
            "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "zoom-in", "zoom-out", "blur-in", "mask-reveal", "zoom-settle", "slide-mask", "none"]
          },
          "visual": {
            "type": "object",
            "required": ["description"],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "componentPath": {
                "type": "string",
                "description": "Path to generated .tsx component (filled by visuals stage)"
              },
              "imagePath": {
                "type": "string",
                "description": "Path to generated PNG image (filled by image-gen stage, POSIX relative to build dir)"
              },
              "videoPath": {
                "type": "string",
                "description": "Path to video file (filled by compile stage for video mode, POSIX relative to build dir)"
              },
              "htmlPath": {
                "type": "string",
                "description": "Path to HTML file (filled by compile stage for html mode, POSIX relative to build dir)"
              }
            }
          },
          "narration": {
            "type": "object",
            "required": ["lines"],
            "additionalProperties": false,
            "properties": {
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["text", "ttsText", "highlights"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "Raw text including ** markers"
                    },
                    "ttsText": {
                      "type": "string",
                      "description": "Plain text for TTS (markers stripped)"
                    },
                    "speakText": {
                      "type": "string",
                      "description": "Synthesis-only rewrite of ttsText from the project dict.md; subtitles still render ttsText"
                    },
                    "instruct": {
                      "type": "string",
                      "description": "Per-line emotion/style instruction passed to the TTS engine (CosyVoice3 instruct / IndexTTS emotion). Overrides the provider-level default for this line only."
                    },
                    "highlights": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["start", "end"],
                        "additionalProperties": false,
                        "properties": {
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              },
              "explicitDurationSec": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Forced duration from @duration directive"
              }
            }
          },
          "audio": {
            "type": "object",
            "required": ["wavPath", "durationSec", "lineTimings"],
            "additionalProperties": false,
            "description": "Filled by tts stage",
            "properties": {
              "wavPath": {
                "type": "string"
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lineTimings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lineIndex", "startMs", "endMs"],
                  "additionalProperties": false,
                  "properties": {
                    "lineIndex": {
                      "type": "number",
                      "minimum": 0
                    },
                    "startMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "charTimings": {
                "type": "array",
                "description": "Char-level timings for karaoke subtitles (block-relative seconds). Filled by tts stage; uniform estimate by default, forced alignment when align-tts is reachable.",
                "items": {
                  "type": "object",
                  "required": ["lineIndex", "char", "startSec", "endSec"],
                  "additionalProperties": false,
                  "properties": {
                    "lineIndex": { "type": "integer", "minimum": 0 },
                    "char": { "type": "string", "minLength": 1 },
                    "startSec": { "type": "number", "minimum": 0 },
                    "endSec": { "type": "number", "minimum": 0 }
                  }
                }
              },
              "subtitleStyle": {
                "type": "string",
                "enum": ["teach", "karaoke", "hype"],
                "description": "块级字幕风格覆盖 meta.subtitleStyle（teach 整行淡入 / karaoke 逐字扫光 / hype 弹跳大字）"
              }
            }
          },
          "timing": {
            "type": "object",
            "required": ["enterSec", "holdSec", "exitSec", "totalSec", "frames", "enterFrames"],
            "additionalProperties": false,
            "description": "Filled by render stage",
            "properties": {
              "enterSec": {
                "type": "number",
                "minimum": 0
              },
              "holdSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exitSec": {
                "type": "number",
                "minimum": 0
              },
              "totalSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "frames": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "enterFrames": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "render": {
            "type": "object",
            "required": ["partialPath", "cacheHit"],
            "additionalProperties": false,
            "description": "Filled by render stage",
            "properties": {
              "partialPath": {
                "type": "string"
              },
              "cacheHit": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Local asset manifest: relative POSIX path → assets/{hash}.ext",
      "additionalProperties": {
        "type": "string",
        "pattern": "^assets/[a-f0-9]+\\.[a-zA-Z0-9]+$"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        },
        "audioGeneratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visualsGeneratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "renderedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
