{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoVideo Script",
  "description": "Schema for script.json — the canonical IR that flows through all AutoVideo stages. Fields are lenient; stage-specific readiness is enforced at the TypeScript layer.",
  "type": "object",
  "required": ["meta", "blocks", "assets", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "title", "voiceRef", "aspect", "width", "height", "fps", "theme", "subtitleSafeBottom"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "voiceRef": {
          "type": "string",
          "description": "Absolute path to reference audio WAV file"
        },
        "aspect": {
          "type": "string",
          "enum": ["16:9", "9:16", "1:1"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "subtitleSafeBottom": {
          "type": "number",
          "minimum": 0
        },
        "avatarRef": {
          "type": "string",
          "description": "Absolute path to avatar loop video for lip-sync overlay"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "enter", "exit", "visual", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B\\d{2,}$",
            "description": "Block ID, e.g. B01, B02"
          },
          "title": {
            "type": "string"
          },
          "visualMode": {
            "type": "string",
            "enum": ["animation", "image", "video"],
            "default": "animation",
            "description": "Visual generation mode: animation (Claude-generated Component.tsx), image (AI-generated PNG), or video (local mp4 file)"
          },
          "imageSource": {
            "type": "string",
            "description": "Path to the source image file (e.g., 'assets/abc12345.png'), set during compile for image mode blocks"
          },
          "videoSource": {
            "type": "string",
            "description": "Path to the source video file (e.g., 'assets/abc12345.mp4'), set during compile for video mode blocks"
          },
          "enter": {
            "type": "string",
            "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "zoom-in", "zoom-out", "none"]
          },
          "exit": {
            "type": "string",
            "enum": ["fade", "fade-up", "fade-down", "slide-left", "slide-right", "zoom-in", "zoom-out", "none"]
          },
          "visual": {
            "type": "object",
            "required": ["description"],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "componentPath": {
                "type": "string",
                "description": "Path to generated .tsx component (filled by visuals stage)"
              },
              "imagePath": {
                "type": "string",
                "description": "Path to generated PNG image (filled by image-gen stage, POSIX relative to build dir)"
              },
              "videoPath": {
                "type": "string",
                "description": "Path to video file (filled by compile stage for video mode, POSIX relative to build dir)"
              }
            }
          },
          "narration": {
            "type": "object",
            "required": ["lines"],
            "additionalProperties": false,
            "properties": {
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["text", "ttsText", "highlights"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "Raw text including ** markers"
                    },
                    "ttsText": {
                      "type": "string",
                      "description": "Plain text for TTS (markers stripped)"
                    },
                    "highlights": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["start", "end"],
                        "additionalProperties": false,
                        "properties": {
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              },
              "explicitDurationSec": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Forced duration from @duration directive"
              }
            }
          },
          "audio": {
            "type": "object",
            "required": ["wavPath", "durationSec", "lineTimings"],
            "additionalProperties": false,
            "description": "Filled by tts stage",
            "properties": {
              "wavPath": {
                "type": "string"
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lineTimings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lineIndex", "startMs", "endMs"],
                  "additionalProperties": false,
                  "properties": {
                    "lineIndex": {
                      "type": "number",
                      "minimum": 0
                    },
                    "startMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "timing": {
            "type": "object",
            "required": ["enterSec", "holdSec", "exitSec", "totalSec", "frames", "enterFrames"],
            "additionalProperties": false,
            "description": "Filled by render stage",
            "properties": {
              "enterSec": {
                "type": "number",
                "minimum": 0
              },
              "holdSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "exitSec": {
                "type": "number",
                "minimum": 0
              },
              "totalSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "frames": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "enterFrames": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "render": {
            "type": "object",
            "required": ["partialPath", "cacheHit"],
            "additionalProperties": false,
            "description": "Filled by render stage",
            "properties": {
              "partialPath": {
                "type": "string"
              },
              "cacheHit": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Local asset manifest: relative POSIX path → assets/{hash}.ext",
      "additionalProperties": {
        "type": "string",
        "pattern": "^assets/[a-f0-9]+\\.[a-zA-Z0-9]+$"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        },
        "audioGeneratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visualsGeneratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "renderedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
