{
  "name": "autovideo",
  "version": "0.1.0",
  "description": "CLI tool to compile Markdown teaching scripts into MP4 videos",
  "type": "module",
  "bin": {
    "autovideo": "dist/bin/autovideo.js"
  },
  "scripts": {
    "build": "tsc",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd web && npm ci && npm run build",
    "build:web": "npm run build:server && npm run build:client",
    "start:web": "NODE_ENV=production node dist/server/server/index.js",
    "dev:web": "concurrently -k \"tsx server/index.ts\" \"cd web && npx vite\"",
    "dev": "tsx bin/autovideo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@babel/parser": "^7.29.3",
    "@remotion/bundler": "^4.0.380",
    "@remotion/google-fonts": "^4.0.380",
    "@remotion/renderer": "^4.0.380",
    "commander": "^12.0.0",
    "ms": "^2.1.3",
    "p-limit": "^5.0.0",
    "pinyin-pro": "^3.28.1",
    "proper-lockfile": "^4.1.2",
    "puppeteer-core": "^24.0.0",
    "hono": "^4.5.0",
    "@hono/node-server": "^1.12.0",
    "remotion": "^4.0.380",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@remotion/cli": "^4.0.380",
    "@types/babel__parser": "^7.0.0",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "ajv": "^8.20.0",
    "concurrently": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
