{
  "tts": {
    "provider": "voxcpm",
    "qa": { "enabled": true, "maxRetries": 2 }
  },
  "voxcpm": {
    "endpoint": "http://127.0.0.1:8000",
    "modelDir": "third_servers/voxcpm-tts/models/VoxCPM2",
    "cfgValue": 2.0,
    "inferenceTimesteps": 10,
    "denoise": false,
    "concurrency": 4
  },
  "cosyvoice": {
    "endpoint": "http://127.0.0.1:8002",
    "modelDir": "third_servers/cosyvoice-tts/models/Fun-CosyVoice3-0.5B",
    "concurrency": 1,
    "normalize": true
  },
  "anthropic": {
    "provider": "anthropic-api",
    "model": "claude-sonnet-4-6",
    "concurrency": 4
  },
  "render": {
    "blockConcurrency": 2,
    "minHoldSec": 1.5,
    "defaultEnterSec": 0.5,
    "defaultExitSec": 0.3,
    "browser": null
  },
  "imageGen": {
    "provider": "sensenova",
    "baseURL": "http://127.0.0.1:8765",
    "timeoutMs": 600000,
    "concurrency": 1,
    "numSteps": 15,
    "cfgScale": 4.0
  },
  "musetalk": {
    "url": "http://127.0.0.1:8001"
  },
  "cache": {
    "dir": "~/.autovideo/cache",
    "maxSizeGB": 20
  }
}
