{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "remotion/**/*.ts",
    "remotion/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}